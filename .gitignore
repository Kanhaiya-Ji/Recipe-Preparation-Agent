# =============================================================
# Recipe Preparation Agent — Root .gitignore
# =============================================================

# --- Environment / Secrets -----------------------------------
# NEVER commit real credentials.  Use *.example files as templates.
.env
.env.local
.env.*.local
.env.development
.env.production
.env.staging
.env.test

# --- IBM watsonx / ADK local config --------------------------
# mcp.json and local adk configs may contain paths with local usernames; exclude it.
.bob/


# --- Python virtual environment ------------------------------
venv/
.venv/
env/
ENV/
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
*.egg

# --- Node / Next.js (web directory) --------------------------
web/node_modules/
web/.next/
web/out/
web/.cache/
web/tsconfig.tsbuildinfo

# --- OS / editor noise ---------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# --- IDE / tool-specific -------------------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# --- Logs & temporary files ----------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
tmp/
temp/

# --- Test / coverage artefacts -------------------------------
coverage/
.nyc_output/
*.lcov

# --- Build / distribution ------------------------------------
dist/
build/
*.zip
*.tar.gz

# --- Upload / generated content ------------------------------
uploads/

# --- Private keys / certificates -----------------------------
*.pem
*.key
*.p12
*.pfx
*.cer
*.crt

# --- Misc secrets & credentials ------------------------------
secrets/
credentials/
*.secret
*.secrets
