# ============================================================
# Recipe Preparation Agent — Environment Variables Template
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local — it contains secrets.
# This file (.env.example) must NEVER contain real credentials.
# ============================================================

# ============================================================
# Public App Configuration (safe to expose to browser)
# ============================================================
NEXT_PUBLIC_APP_NAME=Recipe Preparation Agent

# ============================================================
# IBM watsonx Orchestrate — Core Configuration (SERVER-ONLY)
# Source: IBM Cloud Console / watsonx Orchestrate workspace
# CRITICAL: Do NOT prefix these with NEXT_PUBLIC_ — they must
# stay on the server and never be sent to the browser.
# ============================================================

# Full instance API base URL
# Format: https://api.<region>.watson-orchestrate.cloud.ibm.com/instances/<instance-id>
IBM_ORCHESTRATE_BASE_URL=

# IBM Cloud IAM API Key (from IBM Cloud → Manage → Access → API keys)
IBM_ORCHESTRATE_API_KEY=

# Recipe Agent ID (from watsonx Orchestrate → Agent settings → Agent ID)
IBM_ORCHESTRATE_AGENT_ID=

# Agent version label (e.g. v1, v2, or leave blank for latest)
IBM_ORCHESTRATE_AGENT_VERSION=

# Deployment environment: live or draft
IBM_ORCHESTRATE_ENVIRONMENT=live

# Agent Environment ID (from the embedded chat script: agentEnvironmentId)
IBM_ORCHESTRATE_AGENT_ENV_ID=

# IBM Orchestrate API call pattern:
#   "chat"      — watsonx Orchestrate /v1/chat endpoint (default, recommended)
#   "assistant" — Watson Assistant v2 session/message flow
IBM_ORCHESTRATE_CALL_PATTERN=chat

# ============================================================
# IBM watsonx Orchestrate Host URL (non-secret)
# Used for reference — base URL above takes precedence for API calls.
# ============================================================
IBM_ORCHESTRATE_HOST_URL=https://us-south.watson-orchestrate.cloud.ibm.com

# ============================================================
# Application Configuration
# ============================================================
NODE_ENV=development
PORT=3000
